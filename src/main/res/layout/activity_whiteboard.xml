<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/color_background_secondary"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:subtitle="@string/whiteboard_not_shared"
        app:title="@string/whiteboard_title" />

    <FrameLayout
        android:id="@+id/wb_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The board fills the whole stage. -->
        <eu.siacs.conversations.xmpp.whiteboard.WhiteboardView
            android:id="@+id/wb_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating tool rail, pinned to the bottom-left corner; collapsed by default. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/wb_rail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|bottom"
            android:layout_margin="10dp"
            app:cardBackgroundColor="?attr/whiteboard_rail_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="4dp">

                <!-- Scrollable tool list; the height is clamped in code to the stage. -->
                <ScrollView
                    android:id="@+id/wb_tools"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scrollbars="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_tool_pencil"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_tool_pencil"
                                android:src="@drawable/ic_whiteboard_pencil" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_tool_pencil" />
                        </LinearLayout>

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_tool_line"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_tool_line"
                                android:src="@drawable/ic_whiteboard_line" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_tool_line" />
                        </LinearLayout>

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_tool_arrow"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_tool_arrow"
                                android:src="@drawable/ic_whiteboard_arrow" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_tool_arrow" />
                        </LinearLayout>

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_tool_rect"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_tool_rect"
                                android:src="@drawable/ic_whiteboard_rect" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_tool_rect" />
                        </LinearLayout>

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_tool_ellipse"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_tool_ellipse"
                                android:src="@drawable/ic_whiteboard_ellipse" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_tool_ellipse" />
                        </LinearLayout>

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_tool_text"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_tool_text"
                                android:src="@drawable/ic_whiteboard_text" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_tool_text" />
                        </LinearLayout>

                        <View style="@style/WhiteboardRailDivider" />

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_tool_move"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_tool_move"
                                android:src="@drawable/ic_whiteboard_move" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_tool_move_short" />
                        </LinearLayout>

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_tool_scale"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_tool_scale"
                                android:src="@drawable/ic_whiteboard_scale" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_tool_scale_short" />
                        </LinearLayout>

                        <View style="@style/WhiteboardRailDivider" />

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_tool_pan"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_tool_pan"
                                android:src="@drawable/ic_whiteboard_pan" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_tool_pan_short" />
                        </LinearLayout>

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_reset_view"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_reset_view"
                                android:src="@drawable/ic_whiteboard_reset_view" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_reset_view_short" />
                        </LinearLayout>

                        <View style="@style/WhiteboardRailDivider" />

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_width"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_line_width"
                                android:src="@drawable/ic_whiteboard_width" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_width_short" />
                        </LinearLayout>

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <FrameLayout
                                android:layout_width="46dp"
                                android:layout_height="46dp">

                                <ImageButton
                                    android:id="@+id/wb_stroke"
                                    style="@style/WhiteboardRailButton"
                                    android:contentDescription="@string/whiteboard_line_color"
                                    android:src="@drawable/ic_whiteboard_stroke_color" />

                                <View
                                    android:id="@+id/wb_stroke_swatch"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_gravity="end|bottom"
                                    android:layout_margin="8dp"
                                    android:background="@drawable/whiteboard_swatch" />
                            </FrameLayout>
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_stroke_short" />
                        </LinearLayout>

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <FrameLayout
                                android:layout_width="46dp"
                                android:layout_height="46dp">

                                <ImageButton
                                    android:id="@+id/wb_fill"
                                    style="@style/WhiteboardRailButton"
                                    android:contentDescription="@string/whiteboard_fill_color"
                                    android:src="@drawable/ic_whiteboard_fill" />

                                <View
                                    android:id="@+id/wb_fill_swatch"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_gravity="end|bottom"
                                    android:layout_margin="8dp"
                                    android:background="@drawable/whiteboard_swatch" />
                            </FrameLayout>
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_fill_short" />
                        </LinearLayout>

                        <View style="@style/WhiteboardRailDivider" />

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_undo"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_undo"
                                android:src="@drawable/ic_whiteboard_undo" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_undo" />
                        </LinearLayout>

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_clear"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_clear"
                                android:src="@drawable/ic_whiteboard_clear" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_clear" />
                        </LinearLayout>

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_done"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_finish"
                                android:src="@drawable/ic_whiteboard_done" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_finish_short" />
                        </LinearLayout>

                        <View style="@style/WhiteboardRailDivider" />

                        <LinearLayout style="@style/WhiteboardRailItem">
                            <ImageButton
                                android:id="@+id/wb_share"
                                style="@style/WhiteboardRailButton"
                                android:contentDescription="@string/whiteboard_share"
                                android:src="@drawable/ic_whiteboard_share" />
                            <TextView style="@style/WhiteboardRailLabel"
                                android:text="@string/whiteboard_share_short" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <!-- The toggle sits below the tools: the rail grows upwards from the bottom. -->
                <ImageButton
                    android:id="@+id/wb_rail_toggle"
                    style="@style/WhiteboardRailButton"
                    android:contentDescription="@string/whiteboard_tools_toggle"
                    android:src="@drawable/ic_whiteboard_chevron_right" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/wb_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="16dp"
            android:text="@string/whiteboard_hint"
            android:textColor="#9E9E9E"
            android:textSize="15sp" />
    </FrameLayout>

</LinearLayout>
