<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Keep SquareFrameLayout as the root: it forces the grid cell to stay square. -->
    <eu.siacs.conversations.ui.widget.SquareFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?selectableItemBackground"
        android:padding="2dp">

        <ImageView
            android:id="@+id/media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black54"
            android:scaleType="centerInside" />

        <View
            android:id="@+id/media_selection_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/media_selected"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/media_selection_badge"
            android:contentDescription="@string/selected"
            android:padding="5dp"
            android:src="@drawable/ic_done_black_24dp"
            android:visibility="gone"
            app:tint="@android:color/white" />

    </eu.siacs.conversations.ui.widget.SquareFrameLayout>
</layout>
