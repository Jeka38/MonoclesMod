<?xml version="1.0" encoding="utf-8"?>
<!--
  Popup for the Muji "More" button: the secondary actions as stand-alone round buttons styled
  exactly like the main call controls (MujiCircleButton - grey circle, white icon). There is
  deliberately no shared background/plate behind them, so each button carries only its own circle.
  The switch-camera button is hidden when the device has a single camera.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="4dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/muji_more_switch_camera"
        style="@style/MujiCircleButton"
        android:layout_marginVertical="4dp"
        android:contentDescription="@string/muji_switch_camera"
        app:backgroundTint="#525252"
        app:icon="@drawable/ic_flip_camera_android_black_24dp"
        app:iconTint="@android:color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/muji_more_whiteboard"
        style="@style/MujiCircleButton"
        android:layout_marginVertical="4dp"
        android:contentDescription="@string/muji_whiteboard"
        app:backgroundTint="#525252"
        app:icon="@drawable/ic_whiteboard_call"
        app:iconTint="@android:color/white" />
</LinearLayout>
