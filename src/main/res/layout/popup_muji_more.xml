<?xml version="1.0" encoding="utf-8"?>
<!--
  Popup for the Muji "More" button: the actions stacked vertically as icon-only buttons with no
  backing plate (flat, theme-tinted icons). The switch-camera button is hidden when the device has
  a single camera.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/color_background_secondary"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/muji_more_switch_camera"
            style="@style/MujiFlatButton"
            android:contentDescription="@string/muji_switch_camera"
            app:icon="@drawable/ic_flip_camera_android_black_24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/muji_more_whiteboard"
            style="@style/MujiFlatButton"
            android:contentDescription="@string/muji_whiteboard"
            app:icon="@drawable/ic_whiteboard_call" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
